{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.worker.tsbuildinfo",
    "target": "ES2024",
    "lib": ["ES2024", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@/*": ["./src/*"] },
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true
  },
  "include": ["src/workers/**/*.ts"]
}
