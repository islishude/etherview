{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "semi": true,
  "printWidth": 100,
  "endOfLine": "lf",
  "trailingComma": "all",
  "sortImports": true,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  "proseWrap": "preserve",
  "overrides": [
    { "files": ["**/*.md"], "options": { "embeddedLanguageFormatting": "off" } }
  ],
  "ignorePatterns": [
    "web/**",
    "pnpm-lock.yaml",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    ".git/**",
    ".local/**",
    "data/**",
    "vendor/**",
    "**/*.gen.*",
    "**/*_generated.*",
    "licenses/**",
    "internal/**/testdata/**",
    "deploy/helm/etherview/templates/**",
    "deploy/facilitator/helm/templates/**"
  ]
}
