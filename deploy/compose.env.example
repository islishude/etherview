# Copy to .env for local Compose use. Never commit live credentials.
POSTGRES_PASSWORD=replace-with-a-local-password
ETHERVIEW_RPC_URLS=http://host.docker.internal:8545
ETHERVIEW_CHAIN_ID=1
ETHERVIEW_CHAIN_GENESIS_HASH=0xd4e56740f876aef8c010b86a40d5f56745a118d0906a34e69aec8c0db1cb8fa3
ETHERVIEW_PORT=8080

# Optional process logging overrides. Defaults come from the mounted YAML.
# ETHERVIEW_LOG_LEVEL=debug
# ETHERVIEW_LOG_FORMAT=text

# Optional wallet authentication. The public URL must be a root HTTPS origin
# (plain HTTP is accepted only for loopback development), and the pepper must
# contain at least 32 random bytes. It is passed only to the all/api service.
# Rotating it invalidates every existing browser session.
# ETHERVIEW_FEATURE_USER_AUTH=true
# ETHERVIEW_SERVER_PUBLIC_URL=https://explorer.example.com
# ETHERVIEW_SESSION_PEPPER=replace-with-at-least-32-random-bytes

# Optional x402 v2 exact-EVM billing. Keep routes empty until the facilitator,
# fixed egress CIDRs, asset, recipient, and prices are set in the mounted YAML.
# These secrets are passed only to the all/api service. The optional headers
# value is a JSON object of canonical header names and non-empty string values.
# ETHERVIEW_FEATURE_X402_BILLING=true
# ETHERVIEW_X402_FINGERPRINT_PEPPER=replace-with-an-independent-32-byte-secret
# ETHERVIEW_X402_FACILITATOR_HEADERS={"Authorization":"Bearer replace-me"}

# Optional read/write split. The reader URL may be set in this .env file.
# Reader pool sizes normally come from the mounted YAML config; to override
# them for one Compose invocation, export the two variables in your shell.
# Leaving all three unset keeps one writer pool and preserves YAML sizing.
# ETHERVIEW_DATABASE_READ_URL=postgres://etherview:replace-with-a-local-password@read-postgres:5432/etherview?sslmode=disable
# ETHERVIEW_DATABASE_READ_MAX_CONNECTIONS=20
# ETHERVIEW_DATABASE_READ_MIN_CONNECTIONS=2

# Contract verification v2 uses a pre-pulled generic runner image pinned by
# digest and immutable compiler catalogs. The mounted YAML supplies the
# official catalog defaults; these variables are deployment-time overrides.
# ETHERVIEW_VERIFICATION_RUNNER_IMAGE=registry.example/etherview-compiler-runner@sha256:replace-with-64-lowercase-hex
# Solidity defaults to automatic linux-amd64/linux-arm64 catalog selection.
# Set this only to use an approved mirror:
# ETHERVIEW_VERIFICATION_SOLIDITY_CATALOG_URL=https://mirror.example/linux-arm64/list.json
# ETHERVIEW_VERIFICATION_VYPER_CATALOG_URL=https://raw.githubusercontent.com/blockscout/solc-bin/main/vyper.list.json
# ETHERVIEW_VERIFICATION_ALLOWED_DOWNLOAD_ORIGINS=https://binaries.soliditylang.org,https://raw.githubusercontent.com,https://github.com
# ETHERVIEW_VERIFICATION_CATALOG_REFRESH_INTERVAL=1h
# ETHERVIEW_VERIFICATION_CATALOG_MAX_STALENESS=24h
# ETHERVIEW_SOURCIFY_ATTEMPTS=3
# ETHERVIEW_SOURCIFY_POLL_INTERVAL=1s
# ETHERVIEW_SOURCIFY_MAX_POLLS=120

# Optional `accelerators` profile only. Etherview correctness does not depend
# on these services. Uncomment the application URLs only after provisioning
# the `etherview-cache` bucket in the local object store.
MINIO_ROOT_USER=etherview
MINIO_ROOT_PASSWORD=replace-with-a-local-password
# ETHERVIEW_NATS_URL=nats://nats:4222
# ETHERVIEW_REDIS_URL=redis://redis:6379/0
# ETHERVIEW_S3_ENDPOINT=http://object-storage:9000
# ETHERVIEW_S3_BUCKET=etherview-cache
# ETHERVIEW_S3_ACCESS_KEY=etherview
# ETHERVIEW_S3_SECRET_KEY=replace-with-a-local-password
# ETHERVIEW_S3_PATH_STYLE=true
# ETHERVIEW_OTLP_TRACE_ENDPOINT=http://otel-collector:4318
# ETHERVIEW_OTLP_TRACE_INSECURE=true
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20replace-with-collector-token
