{
	admin off
	auto_https off
	grace_period 10s
	# Request URLs, headers and upstream errors must not enter runtime logs.
	log default {
		output discard
	}
	servers {
		protocols h1 h2
		max_header_size 32KB
		timeouts {
			read_header 5s
			# Hard response deadline also caps SSE; stream_timeout caps WSS.
			write 24h
			read_body 30s
			read_body_idle -1s
			write_idle -1s
			idle 60s
		}
	}
}

(tls_boundary) {
	tls /run/preview-tls/gateway.crt /run/preview-tls/gateway.key
	handle_errors {
		@invalidBody expression `{http.request.host} == 'ipfs.etherview.localhost' && {http.error.status_code} == 413`
		respond @invalidBody "invalid_request" 400
		@tooLarge expression `{http.error.status_code} == 413`
		respond @tooLarge "request_too_large" 413
		respond "upstream_unavailable
" 502
	}
}

(transport) {
	transport http {
		compression off
		dial_timeout 5s
		response_header_timeout 30s
		max_conns_per_host 64
		max_response_header 1MB
	}
	# No retries: a failed write may already have reached the node.
	lb_retries 0
	header_up -Forwarded
	header_up -X-Forwarded-For
	header_up -X-Forwarded-Host
	header_up -X-Forwarded-Proto
}

(node_origin) {
	header +Vary Origin
	@deniedOrigin expression `{http.request.header.Origin} == 'null' || ({http.request.header.Origin} != '' && !({http.request.header.Origin} in {env.PREVIEW_NODE_ALLOWED_ORIGINS}.split(' ')))`
	respond @deniedOrigin "origin_forbidden
" 403
	@allowedOrigin expression `{http.request.header.Origin} != '' && {http.request.header.Origin} in {env.PREVIEW_NODE_ALLOWED_ORIGINS}.split(' ')`
	header @allowedOrigin {
		Access-Control-Allow-Origin {http.request.header.Origin}
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Accept, Eth-Consensus-Version"
		Access-Control-Expose-Headers "Eth-Consensus-Version, Eth-Execution-Optimistic, Eth-Finalized"
	}
	@preflight method OPTIONS
	respond @preflight 204
	request_body {
		max_size 32MiB
	}
}

# Local wallet RPC accepts browser extensions and arbitrary development origins.
(geth_origin) {
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Accept, Eth-Consensus-Version"
		Access-Control-Expose-Headers "Eth-Consensus-Version, Eth-Execution-Optimistic, Eth-Finalized"
	}
	@preflight method OPTIONS
	respond @preflight 204
	request_body {
		max_size 32MiB
	}
}

(node_response) {
	# The gateway owns browser policy; upstream CORS must not override it.
	header_down -Access-Control-Allow-Origin
	header_down -Access-Control-Allow-Credentials
	header_down -Access-Control-Allow-Methods
	header_down -Access-Control-Allow-Headers
	header_down -Access-Control-Expose-Headers
	# The gateway owns Origin policy, including WebSocket requests.
	header_up -Origin
	stream_timeout 24h
}

https://app.etherview.localhost {
	import tls_boundary
	reverse_proxy {$PREVIEW_APP_UPSTREAM:api:8080} {
		import transport
	}
}

https://geth.etherview.localhost {
	import tls_boundary
	route {
		import geth_origin
		@websocket {
			method GET
			header_regexp Connection "(?i)(^|,)[[:blank:]]*upgrade[[:blank:]]*(,|$)"
			header_regexp Upgrade "(?i)^websocket$"
			path /
		}
		reverse_proxy @websocket {$PREVIEW_GETH_WS_UPSTREAM:geth:8546} {
			import transport
			import node_response
		}
		@rpc {
			method POST
			path /
		}
		reverse_proxy @rpc {$PREVIEW_GETH_UPSTREAM:geth:8545} {
			import transport
			import node_response
		}
		respond "not_found
" 404
	}
}

