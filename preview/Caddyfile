https://beacon.etherview.localhost {
	import tls_boundary
	route {
		import node_origin
		@beacon {
			method GET POST
			path /eth/*
		}
		reverse_proxy @beacon {$PREVIEW_BEACON_UPSTREAM:lighthouse:5052} {
			import transport
			import node_response
		}
		respond "not_found
" 404
	}
}

https://bundler.etherview.localhost {
	import tls_boundary
	import node_origin
	@invalidMethod not method POST
	respond @invalidMethod "method_forbidden" 405
	reverse_proxy {$PREVIEW_BUNDLER_UPSTREAM:bundler:4337} {
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}
}

https://ipfs.etherview.localhost {
	import tls_boundary
	route {
		# Inspect the original escaped path, before Caddy's path matcher cleans it.
		# Reject nested escapes, including mixed forms such as %25%32%65; keep literal % names.
		@invalidPath expression `!{http.request.orig_uri}.split('?')[0].startsWith('/ipfs/') || {http.request.orig_uri}.split('?')[0].matches('(?i)(^|/)([.]|%(25)*2e){1,2}(/|$)|%(25)*(2f|5c|00|0d|0a)|%25([0-9a-f]|%[0-9a-f]{2}){2}|[\\\\]')`
		respond @invalidPath "not_found
" 404
		@write not method GET HEAD
		respond @write "method_forbidden
" 403
		# Bounded inspection also rejects unknown-length HTTP/2 and chunked bodies.
		request_body {
			max_size 1
		}
		vars ipfs_body {http.request.body}
		@body expression `({http.request.header.Content-Length} != '' && {http.request.header.Content-Length} != '0') || {http.request.header.Transfer-Encoding} != '' || {http.request.header.Upgrade} != '' || {http.vars.ipfs_body} != ''`
		respond @body "invalid_request
" 400
		timeouts {
			write_timeout 30s
		}
		reverse_proxy {$PREVIEW_IPFS_UPSTREAM:ipfs:8080} {
			# Immediate streaming with cancellation propagation (not flush_interval -1).
			flush_interval 1ms
			header_up Host ipfs.etherview.localhost
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			transport http {
				compression off
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
				max_conns_per_host 64
				max_response_header 1MB
			}
		}
	}
}

http://127.0.0.1:8081 {
	bind 127.0.0.1
	@health path /health
	respond @health "ready
" 200
	respond 404
}

# An unknown Host never reaches one of the fixed upstreams.
https://:443 {
	import tls_boundary
	respond "not_found" 404
}
